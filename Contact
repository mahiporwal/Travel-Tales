<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Travel Tales</title>
    <link rel="stylesheet" href="/Travel Tales/CSS/Contact.css">
</head>
<body>
    <!-- Header Section -->
    <header>
        <div class="logo">Travel Tales</div>
        <nav>
            <ul>
                <li><a href="/Travel Tales/HTML/Home Page">Home</a></li>
                <li><a href="/Travel Tales/HTML/Gallery">Gallery</a></li>
                <li><a href="/Travel Tales/HTML/Blog Page">Blog</a></li>
                <li><a href="/Travel Tales/HTML/Contact" class="active">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Contact Section -->
    <section class="contact">
        <div class="container">
            <h1>Contact Us</h1>
            <p>We'd love to hear from you! Feel free to reach out with your questions, feedback, or travel stories.</p>

            <form action="#" method="POST">
                <div class="form-group">
                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" placeholder="Your Name" required>
                </div>

                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" placeholder="Your Email" required>
                </div>

                <div class="form-group">
                    <label for="message">Message:</label>
                    <textarea id="message" name="message" placeholder="Your Message" rows="5" required></textarea>
                </div>

                <button type="submit">Send Message</button>
            </form>
        </div>
    </section>

    <!-- Footer Section -->
    <footer>
        <p>&copy; 2025 Travel Tales. All Rights Reserved.</p>
        <div class="socials">
            <a href="#">Facebook</a>
            <a href="#">Twitter</a>
            <a href="#">Instagram</a>
        </div>
    </footer>
</body>
</html>

